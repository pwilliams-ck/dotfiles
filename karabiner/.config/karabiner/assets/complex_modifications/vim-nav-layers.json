{
  "title": "Vim nav layers (Colemak / HHKB)",
  "rules": [
    {
      "description": "Layer 1: control+[ -> escape",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "open_bracket",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "escape" }]
        }
      ]
    },
    {
      "description": "Layer 1: control+h/j/k/l -> arrows (shift selects)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["control"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["control"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["control"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["control"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "right_arrow" }]
        }
      ]
    },
    {
      "description": "Layer 2: hold left_option -> nav (add shift to select)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "u",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "y",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_command"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "o",
            "modifiers": { "mandatory": ["left_option"], "optional": ["shift", "caps_lock"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_command"] }]
        }
      ]
    }
  ]
}
