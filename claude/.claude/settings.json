{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-6[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(~/Notes/work-todo.md)"
    ],
    "deny": [
      "mcp__clickup",
      "mcp__atlassian",
      "Bash(git merge:*)",
      "Bash(git merge)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(dd:*)",
      "Bash(shred:*)"
    ],
    "ask": [
      "Agent",
      "Bash(gh:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(truncate:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(sed -i:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag:*)",
      "Bash(git stash push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash clear:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git clean:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git config set:*)",
      "Bash(git config unset:*)",
      "Bash(git submodule:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-fable-5[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/rename-plans.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ctx-handoff-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/bottle.aiff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/bash-write-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/review-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/pr-size-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/agent-ask-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/tool-cadence-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/branch-size-warn.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/turn-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "js-lsp@local-plugins": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "autoScrollEnabled": true,
  "wheelScrollAccelerationEnabled": false,
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true
}
