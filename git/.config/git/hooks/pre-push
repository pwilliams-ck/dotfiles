#!/bin/sh
# Global pre-push (core.hooksPath): block pushes from Claude Code sessions so
# an unintended remote write can't reach teammates. Humans in a terminal are
# unaffected. Runs regardless of what invoked git — Makefiles, npm scripts,
# and repo hooks inherit CLAUDECODE, closing the "push inside a script" hole
# that command-text gates can't see.
#
# Install once:  stow git && git config --global core.hooksPath ~/.config/git/hooks
#
# Known bypasses: `git push --no-verify` skips all pre-push hooks (the
# Claude-side bash-write-gate denies that flag), and a repo-local
# core.hooksPath (e.g. husky) overrides the global one in that repo.
if [ -n "$CLAUDECODE" ]; then
    echo "pre-push: blocked — pushes from Claude Code sessions are denied; run the push yourself" >&2
    exit 1
fi

# core.hooksPath replaces .git/hooks entirely — chain to the repo's own
# pre-push so repos with local hooks keep working. --git-dir, not
# --git-path hooks: the latter resolves back to core.hooksPath (this file).
repo_hook="$(git rev-parse --git-dir)/hooks/pre-push"
if [ -x "$repo_hook" ]; then
    exec "$repo_hook" "$@"
fi
exit 0
